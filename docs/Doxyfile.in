# Doxygen configuration for SDL3_gfx (only non-default settings).
# Generated by CMake into the build directory; build with:
#   cmake --build --preset win-release --target docs

PROJECT_NAME           = "SDL3_gfx"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "Graphics primitives, rotozoomer, framerate control and image filters for SDL3"
OUTPUT_DIRECTORY       = @SDL3GFX_DOCS_OUTPUT@
INPUT                  = @PROJECT_SOURCE_DIR@/README.md \
                         @PROJECT_SOURCE_DIR@/SDL3_gfxPrimitives.h \
                         @PROJECT_SOURCE_DIR@/SDL3_gfxPrimitives.c \
                         @PROJECT_SOURCE_DIR@/SDL3_rotozoom.h \
                         @PROJECT_SOURCE_DIR@/SDL3_rotozoom.c \
                         @PROJECT_SOURCE_DIR@/SDL3_framerate.h \
                         @PROJECT_SOURCE_DIR@/SDL3_framerate.c \
                         @PROJECT_SOURCE_DIR@/SDL3_imageFilter.h \
                         @PROJECT_SOURCE_DIR@/SDL3_imageFilter.c \
                         @PROJECT_SOURCE_DIR@/docs/BUILDING.md \
                         @PROJECT_SOURCE_DIR@/docs/PERFORMANCE.md \
                         @PROJECT_SOURCE_DIR@/docs/CODE_REVIEW.md \
                         @PROJECT_SOURCE_DIR@/CHANGELOG.md
USE_MDFILE_AS_MAINPAGE = @PROJECT_SOURCE_DIR@/README.md
IMAGE_PATH             = @PROJECT_SOURCE_DIR@/docs @PROJECT_SOURCE_DIR@/Screenshots
FILE_PATTERNS          = *.h *.c *.md
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
JAVADOC_AUTOBRIEF      = NO
MARKDOWN_SUPPORT       = YES
MARKDOWN_ID_STYLE      = GITHUB
TOC_INCLUDE_HEADINGS   = 3
SOURCE_BROWSER         = YES
STRIP_FROM_PATH        = @PROJECT_SOURCE_DIR@
FULL_PATH_NAMES        = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = SDL3_GFXPRIMITIVES_SCOPE= \
                         SDL3_ROTOZOOM_SCOPE= \
                         SDL3_FRAMERATE_SCOPE= \
                         SDL3_IMAGEFILTER_SCOPE= \
                         __cplusplus=
GENERATE_LATEX         = NO
GENERATE_HTML          = YES
HTML_COLORSTYLE        = LIGHT
HAVE_DOT               = @SDL3GFX_DOCS_HAVE_DOT@
DOT_PATH               = @SDL3GFX_DOCS_DOT_PATH@
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
