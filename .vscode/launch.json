{
	// Debug the target selected in the CMake Tools status bar ("Set Launch/Debug Target").
	// Demos load sample images from their own folder, so the working directory is the target folder.
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug CMake target (Windows, MSVC)",
			"type": "cppvsdbg",
			"request": "launch",
			"program": "${command:cmake.launchTargetPath}",
			"args": [],
			"cwd": "${command:cmake.getLaunchTargetDirectory}",
			"console": "integratedTerminal"
		},
		{
			"name": "Debug CMake target (Linux, gdb)",
			"type": "cppdbg",
			"request": "launch",
			"program": "${command:cmake.launchTargetPath}",
			"args": [],
			"cwd": "${command:cmake.getLaunchTargetDirectory}",
			"MIMode": "gdb",
			"setupCommands": [
				{ "description": "Pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
			]
		}
	]
}
