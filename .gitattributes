# Normalize text files to LF in the repository; check out with native line endings.
* text=auto

*.c     text diff=cpp
*.h     text diff=cpp
*.cmake text
*.in    text
*.json  text
*.md    text
*.txt   text
*.sh    text eol=lf
*.ps1   text eol=crlf

*.bmp   binary
*.png   binary
*.jpg   binary
*.zip   binary

# fuzz inputs are raw bytes
fuzz/corpus/** binary
fuzz/regressions/** binary
fuzz/regressions/README.md text
